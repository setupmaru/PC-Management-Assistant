NODE_ENV=production

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pc_assistant

# JWT secrets (minimum 32 characters in production)
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this

# Gmail email verification (use a Google App Password, not your normal password)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM=your-account@gmail.com
# Optional; defaults to JWT_ACCESS_SECRET when omitted
EMAIL_VERIFICATION_SECRET=change-this-to-an-independent-random-secret
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Toss Payments
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
TOSS_WEBHOOK_SECRET=
TOSS_PLUS_PRICE=4900
TOSS_PRO_PRICE=15000

# Optional legacy Stripe integration
# STRIPE_SECRET_KEY=sk_live_...

# Public server URL and allowed browser origins
PUBLIC_BASE_URL=http://api.setupmaru.com:3400
ALLOWED_ORIGINS=http://api.setupmaru.com:3400

# Server bind address
PORT=3400
HOST=0.0.0.0
